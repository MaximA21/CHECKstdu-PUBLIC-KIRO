{
  "database": {
    "provider": "mock",
    "table_prefix": "dev_",
    "timeout_seconds": 30
  },
  "messaging": {
    "provider": "mock",
    "queue_prefix": "dev_",
    "timeout_seconds": 30
  },
  "logging": {
    "provider": "console",
    "level": "DEBUG",
    "structured": true
  },
  "providers": {
    "byteme": {
      "enabled": true,
      "timeout_seconds": 30,
      "retry_attempts": 3,
      "config": {
        "base_url": "https://api.byteme.example.com"
      }
    },
    "verbyndich": {
      "enabled": true,
      "timeout_seconds": 30,
      "retry_attempts": 3,
      "config": {
        "base_url": "https://api.verbyndich.example.com"
      }
    },
    "webwunder": {
      "enabled": false,
      "timeout_seconds": 30,
      "retry_attempts": 3,
      "config": {
        "base_url": "https://api.webwunder.example.com"
      }
    },
    "pingperfect": {
      "enabled": false,
      "timeout_seconds": 30,
      "retry_attempts": 3,
      "config": {
        "base_url": "https://api.pingperfect.example.com"
      }
    }
  },
  "container": {
    "http_port": 8080,
    "websocket_port": 8081,
    "cors_enabled": true,
    "request_timeout_seconds": 60,
    "max_connections": 100,
    "health_check_interval": 10
  },
  "debug": true
}