{
  "database": {
    "provider": "aws_dynamodb",
    "region": "eu-central-1",
    "table_prefix": "staging_",
    "timeout_seconds": 30
  },
  "messaging": {
    "provider": "aws_sqs",
    "region": "eu-central-1",
    "queue_prefix": "staging_",
    "timeout_seconds": 30
  },
  "logging": {
    "provider": "aws_cloudwatch",
    "level": "DEBUG",
    "structured": true,
    "log_group": "/aws/lambda/webwunder-staging",
    "region": "eu-central-1"
  },
  "providers": {
    "byteme": {
      "enabled": true,
      "timeout_seconds": 30,
      "retry_attempts": 3,
      "config": {
        "base_url": "https://staging-api.byteme.com"
      }
    },
    "verbyndich": {
      "enabled": true,
      "timeout_seconds": 30,
      "retry_attempts": 3,
      "config": {
        "base_url": "https://staging-api.verbyndich.com"
      }
    },
    "webwunder": {
      "enabled": true,
      "timeout_seconds": 30,
      "retry_attempts": 3,
      "config": {
        "base_url": "https://staging-api.webwunder.com"
      }
    },
    "pingperfect": {
      "enabled": true,
      "timeout_seconds": 30,
      "retry_attempts": 3,
      "config": {
        "base_url": "https://staging-api.pingperfect.com"
      }
    }
  },
  "container": {
    "http_port": 8080,
    "websocket_port": 8081,
    "cors_enabled": true,
    "request_timeout_seconds": 30,
    "max_connections": 500,
    "health_check_interval": 30
  },
  "debug": true
}