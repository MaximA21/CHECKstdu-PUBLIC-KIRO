# AGGRESSIVE cost optimization for student budget (saves ~$60-80/month)
log_retention_days                = 7   # Reduced from 30 days (saves ~$10-15/month)
lambda_log_retention_days         = 7   # Reduced from 14 days (saves ~$5-10/month)
step_functions_log_retention_days = 7   # Reduced from 7 days (minimal change)

# Disable expensive backup service (saves ~$20-50/month)
# Use DynamoDB point-in-time recovery only
backup_retention_days     = 0    # Disable AWS Backup service
backup_cold_storage_days  = 0    # Disable cold storage

# API Gateway settings (keep existing for functionality)
canary_enabled                = true
canary_traffic_percentage     = 10
rest_api_throttle_rate_limit  = 500
rest_api_throttle_burst_limit = 1000
rest_api_cache_ttl           = 300

# Student budget cost controls
enable_kinesis_stream     = false  # Remove Kinesis stream (saves ~$28/month)
enable_custom_kms_keys    = false  # Use AWS managed keys (saves ~$2/month)
enable_aws_backup         = false  # Disable AWS Backup service (saves ~$20-50/month)
minimal_cloudwatch_alarms = true   # Only essential alarms (saves ~$3-5/month)

# Cost monitoring thresholds for student budget
monthly_cost_alert_threshold = 15   # Alert at 15 EUR/month
monthly_cost_limit_threshold = 20   # Hard limit at 20 EUR/month