# Authorizer Lambda-Funktion
resource "aws_lambda_function" "authorizer" {
  function_name = "${var.project_name}-${var.environment}-authorizer"
  role          = aws_iam_role.lambda_role.arn
  handler       = "authorizer.lambda_handler"
  runtime       = "python3.9"
  timeout       = 10

  filename         = "./lambda_packages/authorizer.zip"
  source_code_hash = filebase64sha256("./lambda_packages/authorizer.zip")

  #environment {
   # variables = {
    #  GOOGLE_MAPS_API_KEY = var.google_maps_api_key  # Für die Adressvalidierung
    #}
  #}

  tags = {
    Name        = "${var.project_name}-authorizer"
    Environment = var.environment
  }
}

# Connect Handler Lambda-Funktion
resource "aws_lambda_function" "connect_handler" {
  function_name = "${var.project_name}-${var.environment}-connect-handler"
  role          = aws_iam_role.lambda_role.arn
  handler       = "connect_handler.lambda_handler"
  runtime       = "python3.9"
  timeout       = 10

  filename         = "./lambda_packages/connect_handler.zip"
  source_code_hash = filebase64sha256("./lambda_packages/connect_handler.zip")

  #environment {
   # variables = {
    #  DYNAMODB_TABLE = aws_dynamodb_table.sessions.name
    #}
 # }

  tags = {
    Name        = "${var.project_name}-connect-handler"
    Environment = var.environment
  }
}

# Search Handler Lambda-Funktion
